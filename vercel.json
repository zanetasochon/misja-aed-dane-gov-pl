{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npx ng build --configuration vercel",
  "outputDirectory": "dist/frontend/browser",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/proxy?__t=api&__p=$1" },
    { "source": "/media/(.*)", "destination": "/api/proxy?__t=media&__p=$1" },
    { "source": "/flags/(.*)", "destination": "/api/proxy?__t=flags&__p=$1" },
    { "source": "/cms/(.*)", "destination": "/api/proxy?__t=cms&__p=$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
